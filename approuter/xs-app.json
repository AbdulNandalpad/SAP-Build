{
  "authenticationMethod": "route",
  "sessionTimeout": 60,
  "routes": [
    {
      "source": "^/odata/(.*)",
      "destination": "tss-backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)",
      "localDir": "ui",
      "authenticationType": "xsuaa"
    }
  ]
}
