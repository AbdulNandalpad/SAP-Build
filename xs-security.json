{
  "xsappname": "tss-dev-platform",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.eu10.hana.ondemand.com/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.user",
      "description": "Authenticated Trelleborg user"
    }
  ],
  "role-templates": [
    {
      "name": "User",
      "description": "Any authenticated Trelleborg user",
      "scope-references": ["$XSAPPNAME.user"]
    }
  ],
  "role-collections": [
    {
      "name": "TSS Platform User",
      "description": "Access to TSS BTP applications — any authenticated Trelleborg user",
      "role-template-references": ["$XSAPPNAME.User"]
    }
  ]
}
